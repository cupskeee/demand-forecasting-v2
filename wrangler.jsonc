// Cloudflare deployment: the built site in dist/ is served as static files.
// There is no server code: the forecasting runs in the visitor's browser.
{
  "name": "demand-forecasting-v2",
  "compatibility_date": "2026-11-14",
  // Serve the site on its own subdomain.
  "routes": [
    { "pattern": "demand-forecasting-v2.yusuframadhan.dev", "custom_domain": true }
  ],
  // The workers.dev address is off, so search engines find only one copy of the site.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
